{
  "manifest_version": 3,
  "name": "YouTube to Perplexity",
  "version": "1.0.14",
  "description": "Send YouTube videos, playlists, channels, and search results to Perplexity for AI-powered summaries and research.",
  "homepage_url": "https://github.com/christianboyle/youtube-to-perplexity",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-to-perplexity@christianboyle.github.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "tabs", "contextMenus", "clipboardWrite"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*"
  ],
  "background": {
    "scripts": ["src/background/background.js"]
  },
  "action": {
    "default_title": "YouTube to Perplexity",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "src/lib/storage.js",
        "src/lib/perplexity.js",
        "src/lib/youtube.js",
        "src/lib/send.js",
        "src/content/youtube.js"
      ],
      "css": ["src/content/youtube.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*"
      ],
      "js": ["src/lib/send.js", "src/content/perplexity.js"],
      "run_at": "document_idle"
    }
  ]
}
